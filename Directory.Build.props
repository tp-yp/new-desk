<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Lets the Windows-only projects build on Linux/macOS too (CI and cloud dev). They still only run on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Company>NewDesk</Company>
    <Product>NewDesk</Product>
  </PropertyGroup>
</Project>
