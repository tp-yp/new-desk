<Window x:Class="NewDesk.Shell.ControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NewDesk"
        FlowDirection="RightToLeft"
        Width="380" SizeToContent="Height"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStyle="ToolWindow">
    <StackPanel Margin="16">
        <TextBlock x:Name="Heading" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
        <TextBlock x:Name="Body" TextWrapping="Wrap" Margin="0,0,0,8" />
        <TextBlock x:Name="Hotkey" TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,16" />
        <StackPanel Orientation="Horizontal">
            <Button x:Name="RestoreButton" Click="OnRestore" Padding="12,6" Margin="0,0,8,0" />
            <Button x:Name="CrashButton" Click="OnSimulateCrash" Padding="12,6" />
        </StackPanel>
    </StackPanel>
</Window>
