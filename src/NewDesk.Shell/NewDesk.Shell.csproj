<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF0001: Fluent ThemeMode is marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\NewDesk.Platform\NewDesk.Platform.csproj" />
    <!-- The shell refuses to hide anything unless the watchdog sits next to it, so ship them together. -->
    <ProjectReference Include="..\NewDesk.Watchdog\NewDesk.Watchdog.csproj" />
  </ItemGroup>
</Project>
